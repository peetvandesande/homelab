// Grafana Alloy on @@HOST@@: ship the journal to Loki at home over the
// tunnel. Managed from homelab/alloy/outside - edit there, not here; installed
// by alloy/scripts/install-outside.sh, which fills in the host.
//
// This server holds no lab certificate, so Alloy's own HTTP server is not
// TLS: it stays on the package default, 127.0.0.1:12345, and nothing scrapes
// it. Whether it is shipping is asked of Loki instead (the @@HOST@@-logs-quiet
// alert in grafana/).

logging {
  level  = "warn"
  format = "logfmt"
}

// postfix, dovecot and sshd log to the journal; nginx's access logs are files,
// read below. max_age is just under Loki's reject_old_samples_max_age (168h), so
// the first run backfills a week without the oldest batch being rejected.
loki.source.journal "host" {
  max_age       = "166h"
  // Not constants.hostname: OVH's images name the machines vps-<hex>.
  labels        = { host = "@@HOST@@" }
  relabel_rules = loki.relabel.journal.rules
  forward_to    = [loki.write.loki.receiver]
}

// Bounded labels only - every value is a Loki stream. Filter on content
// (recipients, queue ids, client addresses) with LogQL, never by promoting it.
loki.relabel "journal" {
  forward_to = []

  rule {
    source_labels = ["__journal__systemd_unit"]
    target_label  = "unit"
  }

  // session-c<N>.scope increments forever; collapse it so each login is not
  // a new stream.
  rule {
    source_labels = ["unit"]
    regex         = "session-.+\\.scope"
    replacement   = "session.scope"
    target_label  = "unit"
  }

  rule {
    source_labels = ["__journal_syslog_identifier"]
    target_label  = "identifier"
  }

  rule {
    source_labels = ["__journal_priority_keyword"]
    target_label  = "level"
  }

  // Containers logging through journald carry their name; absent otherwise.
  rule {
    source_labels = ["__journal_container_name"]
    target_label  = "container"
  }
}

// nginx writes its access logs to files, not the journal, one per site, named
// after it. Only the live file is followed; Alloy keeps its place across
// rotation. tail_from_end, so the first run does not send weeks of old lines
// for Loki to reject. A host with no nginx simply matches nothing.
local.file_match "nginx" {
  path_targets = [{
    __path__ = "/var/log/nginx/*access.log",
    host     = "@@HOST@@",
    job      = "nginx",
  }]
}

loki.source.file "nginx" {
  targets       = local.file_match.nginx.targets
  tail_from_end = true
  forward_to    = [loki.process.nginx.receiver]
}

// rspamd logs its verdicts to a file too.
local.file_match "rspamd" {
  path_targets = [{
    __path__ = "/var/log/rspamd/rspamd.log",
    host     = "@@HOST@@",
    job      = "rspamd",
  }]
}

loki.source.file "rspamd" {
  targets       = local.file_match.rspamd.targets
  tail_from_end = true
  forward_to    = [loki.process.drop_filename.receiver]
}

loki.process "drop_filename" {
  forward_to = [loki.write.loki.receiver]

  stage.label_drop {
    values = ["filename"]
  }
}

// The site from the file name, then the path dropped: one stream per site.
loki.process "nginx" {
  forward_to = [loki.write.loki.receiver]

  stage.regex {
    source     = "filename"
    // ntfy.sogode.com.access.log and sogode.com-https-access.log both give the
    // name; plain access.log, the default server, gets no site label.
    expression = "/var/log/nginx/(?P<site>[^/]+?)(-https?)?[-.]access\\.log$"
  }

  stage.labels {
    values = { site = "" }
  }

  stage.label_drop {
    values = ["filename"]
  }
}

// loki.home resolves through home's DNS and routes over the tunnel to home.
// Verified against the lab root only, never the system store, and by name
// against the DNS SAN on Loki's certificate.
loki.write "loki" {
  endpoint {
    url = "https://loki.home:3100/loki/api/v1/push"

    tls_config {
      ca_file = "/etc/alloy/homelab-root-g2.crt"
    }
  }
}
