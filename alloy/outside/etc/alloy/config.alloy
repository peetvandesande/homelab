// Grafana Alloy on @@HOST@@: ship the journal to Loki at home over the
// tunnel. Managed from homelab/alloy/outside - edit there, not here; installed
// by alloy/scripts/install-outside.sh, which fills in the host.
//
// This server holds no lab certificate, so Alloy's own HTTP server is not
// TLS: it stays on the package default, 127.0.0.1:12345, and nothing scrapes
// it. Whether it is shipping is asked of Loki instead (the @@HOST@@-logs-quiet
// alert in grafana/).

logging {
  level  = "warn"
  format = "logfmt"
}

// The journal is the only source; postfix, dovecot, nginx and sshd all log
// there. max_age is just under Loki's reject_old_samples_max_age (168h), so
// the first run backfills a week without the oldest batch being rejected.
loki.source.journal "host" {
  max_age       = "166h"
  // Not constants.hostname: OVH's images name the machines vps-<hex>.
  labels        = { host = "@@HOST@@" }
  relabel_rules = loki.relabel.journal.rules
  forward_to    = [loki.write.loki.receiver]
}

// Bounded labels only - every value is a Loki stream. Filter on content
// (recipients, queue ids, client addresses) with LogQL, never by promoting it.
loki.relabel "journal" {
  forward_to = []

  rule {
    source_labels = ["__journal__systemd_unit"]
    target_label  = "unit"
  }

  // session-c<N>.scope increments forever; collapse it so each login is not
  // a new stream.
  rule {
    source_labels = ["unit"]
    regex         = "session-.+\\.scope"
    replacement   = "session.scope"
    target_label  = "unit"
  }

  rule {
    source_labels = ["__journal_syslog_identifier"]
    target_label  = "identifier"
  }

  rule {
    source_labels = ["__journal_priority_keyword"]
    target_label  = "level"
  }

  // Containers logging through journald carry their name; absent otherwise.
  rule {
    source_labels = ["__journal_container_name"]
    target_label  = "container"
  }
}

// loki.home resolves through home's DNS and routes over the tunnel to home.
// Verified against the lab root only, never the system store, and by name
// against the DNS SAN on Loki's certificate.
loki.write "loki" {
  endpoint {
    url = "https://loki.home:3100/loki/api/v1/push"

    tls_config {
      ca_file = "/etc/alloy/homelab-root-g2.crt"
    }
  }
}
