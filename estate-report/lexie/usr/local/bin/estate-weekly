    "LOKI_URL": "https://loki.home:3100",
    "GRAFANA_URL": "https://grafana.home:3000",
    "GRAFANA_TOKEN": "",
    "PROMPT": "/etc/estate-report/prompt.md",
    # Scrape jobs known to be down, reported but not counted as issues.
    "IGNORE_JOBS": "",
    # Hosts off by choice most of the time: shown, never an issue. hermes runs
    # only while a lab needs it.
    "IGNORE_HOSTS": "hermes",
    # The follow-up. Both receivers bind lexie's LAN address only, and lexie's
    # own name resolves to loopback on lexie, so they are reached by address;
    # their certificates carry it as an IP SAN.
    "RESPONDER_URL": "https://192.168.8.24:9095/alert",
