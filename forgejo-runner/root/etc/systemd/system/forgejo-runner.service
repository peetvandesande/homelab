[Unit]
Description=Forgejo Actions runner (host jobs, label lexie)
Documentation=file:/etc/forgejo-runner/config.yml
After=network-online.target
Wants=network-online.target

[Service]
User=forgejo-runner
Group=forgejo-runner
WorkingDirectory=/var/lib/forgejo-runner
# The shared secret (root-only on disk), readable by the service alone.
LoadCredential=token:/etc/forgejo-runner/token
ExecStart=/usr/local/bin/forgejo-runner daemon --config /etc/forgejo-runner/config.yml
Restart=on-failure
RestartSec=10
NoNewPrivileges=yes
ProtectSystem=full
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
