// Syslog receiver for esther, the ESXi host at 192.168.1.20. Managed from
// homelab/esxi and present ONLY on the loki container - it sits beside the
// fleet file config.alloy, which Alloy loads from the same directory.
//
// ESXi cannot run a shipper, so it forwards with its own vmsyslogd over TLS
// to this listener, verifying it against the lab CA (the certificate carries
// an IP SAN; ESXi is pointed at the IP for the usual reason - nothing
// resolves .home yet).
//
// RFC 5424, not ESXi's default. The default is "RFC 3164" with RFC 3339
// timestamps, which Alloy's rfc3164 parser rejects outright ("expecting a
// sequence number"), so configure-host.sh asks esther for
// ?formatter=RFC_5424. ESXi 8.0 U2 IA (build 22380479) emitted malformed
// structured data in that mode; esther is 8.0.3 build 24859861. If parse
// warnings appear in this Alloy's journal after an ESXi update, that bug is
// the first suspect.

loki.source.syslog "esxi" {
  listener {
    address                = "0.0.0.0:1514"
    protocol               = "tcp"
    syslog_format          = "rfc5424"
    use_incoming_timestamp = true
    labels                 = { job = "esxi-syslog" }

    tls_config {
      cert_file   = "/etc/homelab-tls/host.crt"
      key_file    = "/etc/homelab-tls/host.key"
      min_version = "TLS12"
    }
  }

  relabel_rules = loki.relabel.esxi.rules
  forward_to    = [loki.write.loki.receiver]
}

// Same label set as the journal on every other host - host, identifier,
// level - so one LogQL query spans the fleet and the hypervisor alike.
// There is no unit on ESXi; the app name (Hostd, vpxa, vmkernel) is the
// identifier.
loki.relabel "esxi" {
  forward_to = []

  // esther.lan -> esther. The short name, like every journal-shipped host.
  rule {
    source_labels = ["__syslog_message_hostname"]
    regex         = "([^.]+).*"
    replacement   = "$1"
    target_label  = "host"
  }

  rule {
    source_labels = ["__syslog_message_app_name"]
    target_label  = "identifier"
  }

  rule {
    source_labels = ["__syslog_message_severity"]
    target_label  = "level"
  }

  // The syslog parser spells four severities differently from journald.
  // Rewrite them so {level="err"} means the same thing on every host.
  rule {
    source_labels = ["level"]
    regex         = "emergency"
    replacement   = "emerg"
    target_label  = "level"
  }

  rule {
    source_labels = ["level"]
    regex         = "critical"
    replacement   = "crit"
    target_label  = "level"
  }

  rule {
    source_labels = ["level"]
    regex         = "error"
    replacement   = "err"
    target_label  = "level"
  }

  rule {
    source_labels = ["level"]
    regex         = "informational"
    replacement   = "info"
    target_label  = "level"
  }
}
