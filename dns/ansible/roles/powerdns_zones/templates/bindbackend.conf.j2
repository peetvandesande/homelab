# Zones served by Pythia from the bind backend.
#
# GENERATED by dns/ansible - do not edit this file by hand.
# The source is dns/ansible/group_vars/all.yml; adding a zone there and running
# `ansible-playbook zones.yml` rewrites this file and runs
# `pdns_control rediscover` so the server picks the new zone up.
#
# Only the `backend: bind` zones are here. The Proxmox labs' zones are
# `backend: api` and live in gsqlite3, because a lab writes its own records at
# runtime; the playbook reconciles those over the API instead.
{% for z in bind_zones %}
{% if z.kind == 'override' %}

# Split-horizon override of a single public name - NOT the whole domain.
# Needs a forward-zone AND an addNTA() on Delphi; the parent domain is signed.
{% else %}

{% endif %}
zone "{{ z.name }}" {
    type master;
    file "{{ zone_dir }}/{{ z.name }}.zone";
};
{% endfor %}
