; Reverse zone for 192.168.8.0/24.
; Every PTR here is generated from the A records in the forward zones -
; there is nothing to keep in step by hand.
;
; GENERATED by dns/ansible - do not edit this file by hand.
; The source is dns/ansible/group_vars/all.yml. Change it there and run
;   cd dns/ansible && ansible-playbook zones.yml
; which rewrites this file, bumps the serial only if the contents changed,
; pushes it to Pythia and reloads just this zone.
$TTL 3600
$ORIGIN 8.168.192.in-addr.arpa.

@       IN  SOA pythia.home. hostmaster.home. (
                2026102801  ; serial
                3600        ; refresh
                900         ; retry
                604800      ; expire
                3600 )      ; negative TTL

@       IN  NS      pythia.home.

1       IN  PTR gw.home.
21      IN  PTR lenora.home.
50      IN  PTR themis.home.
51      IN  PTR delphi.home.
52      IN  PTR pythia.home.
53      IN  PTR prometheus.home.
54      IN  PTR grafana.home.
55      IN  PTR pistis.home.
56      IN  PTR loki.home.
57      IN  PTR hermes.home.
27      IN  PTR moby.home.
; .73 and .74 are extra addresses on moby, one per published stack.
73      IN  PTR nextcloud.home.
74      IN  PTR traefik.home.
60      IN  PTR jellyfin.home.
61      IN  PTR navidrome.home.
62      IN  PTR forgejo.home.
90      IN  PTR homeassistant.home.
24      IN  PTR lexie.home.
241     IN  PTR printer.home.
