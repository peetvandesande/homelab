; Forward zone for the lab.
;
; GENERATED by dns/ansible - do not edit this file by hand.
; The source is dns/ansible/group_vars/all.yml. Change it there and run
;   cd dns/ansible && ansible-playbook zones.yml
; which rewrites this file, bumps the serial only if the contents changed,
; pushes it to Pythia and reloads just this zone.
$TTL 3600
$ORIGIN home.

@       IN  SOA pythia.home. hostmaster.home. (
                2026102106  ; serial
                3600        ; refresh
                900         ; retry
                604800      ; expire
                3600 )      ; negative TTL

@       IN  NS      pythia.home.

; --- infrastructure -------------------------------------------------
gw          IN  A   192.168.8.1
lenora      IN  A   192.168.8.21     ; Proxmox host
themis      IN  A   192.168.8.50     ; dnsdist - the LAN's resolver
delphi      IN  A   192.168.8.51     ; recursor + filtering
pythia      IN  A   192.168.8.52     ; this server
prometheus  IN  A   192.168.8.53
grafana     IN  A   192.168.8.54
pistis      IN  A   192.168.8.55     ; step-ca private CA
loki        IN  A   192.168.8.56     ; log store
hermes      IN  A   192.168.8.57     ; mailcow VM 109 - mail for the labs
moby        IN  A   192.168.8.27     ; Docker host - outside the .50-.59 range
; .73 and .74 are extra addresses on moby, one per published stack.
nextcloud   IN  A   192.168.8.73     ; on moby, published on its own address
traefik     IN  A   192.168.8.74     ; on moby, published on its own address

; --- production -----------------------------------------------------
jellyfin    IN  A   192.168.8.60
navidrome   IN  A   192.168.8.61
homeassistant IN  A   192.168.8.90     ; HAOS VM 302 - outside the .60-.69 range

; --- non-production -------------------------------------------------
lexie       IN  A   192.168.8.24

; --- aliases --------------------------------------------------------
dns         IN  CNAME themis.home.
ca          IN  CNAME pistis.home.
pve         IN  CNAME lenora.home.
