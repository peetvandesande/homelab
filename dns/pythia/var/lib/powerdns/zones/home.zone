; Forward zone for the lab.
;
; GENERATED by dns/ansible - do not edit this file by hand.
; The source is dns/ansible/group_vars/all.yml. Change it there and run
;   cd dns/ansible && ansible-playbook zones.yml
; which rewrites this file, bumps the serial only if the contents changed,
; pushes it to Pythia and reloads just this zone.
$TTL 3600
$ORIGIN home.

@       IN  SOA pythia.home. hostmaster.home. (
                2026102701  ; serial
                3600        ; refresh
                900         ; retry
                604800      ; expire
                3600 )      ; negative TTL

@       IN  NS      pythia.home.

; --- infrastructure -------------------------------------------------
gw          IN  A   192.168.8.1
gw          IN  AAAA fd33:5692:1834:1000:0000:0000:0000:0001
lenora      IN  A   192.168.8.21     ; Proxmox host
lenora      IN  AAAA fd33:5692:1834:1000:0000:0000:0000:0021 ; Proxmox host
themis      IN  A   192.168.8.50     ; dnsdist - the LAN's resolver
themis      IN  AAAA fd33:5692:1834:1000:be24:11ff:feda:9b4b ; dnsdist - the LAN's resolver
delphi      IN  A   192.168.8.51     ; recursor + filtering
delphi      IN  AAAA fd33:5692:1834:1000:be24:11ff:fe7d:3b06 ; recursor + filtering
pythia      IN  A   192.168.8.52     ; this server
pythia      IN  AAAA fd33:5692:1834:1000:be24:11ff:fe06:d987 ; this server
prometheus  IN  A   192.168.8.53
prometheus  IN  AAAA fd33:5692:1834:1000:be24:11ff:fe65:ad6b
grafana     IN  A   192.168.8.54
grafana     IN  AAAA fd33:5692:1834:1000:be24:11ff:fe8f:a8c9
pistis      IN  A   192.168.8.55     ; step-ca private CA
pistis      IN  AAAA fd33:5692:1834:1000:be24:11ff:fe04:f703 ; step-ca private CA
loki        IN  A   192.168.8.56     ; log store
loki        IN  AAAA fd33:5692:1834:1000:be24:11ff:fe5e:a645 ; log store
hermes      IN  A   192.168.8.57     ; mailcow VM 109 - mail for the labs
hermes      IN  AAAA fd33:5692:1834:1000:be24:11ff:fe1b:5d14 ; mailcow VM 109 - mail for the labs
moby        IN  A   192.168.8.27     ; Docker host - outside the .50-.59 range
moby        IN  AAAA fd33:5692:1834:1000:be24:11ff:fe13:54b8 ; Docker host - outside the .50-.59 range
; .73 and .74 are extra addresses on moby, one per published stack.
nextcloud   IN  A   192.168.8.73     ; on moby, published on its own address
traefik     IN  A   192.168.8.74     ; on moby, published on its own address

; --- production -----------------------------------------------------
jellyfin    IN  A   192.168.8.60
jellyfin    IN  AAAA fd33:5692:1834:1000:be24:11ff:fee5:b13b
navidrome   IN  A   192.168.8.61
navidrome   IN  AAAA fd33:5692:1834:1000:be24:11ff:fed8:d621
homeassistant IN  A   192.168.8.90     ; HAOS VM 302 - outside the .60-.69 range

; --- non-production -------------------------------------------------
lexie       IN  A   192.168.8.24
lexie       IN  AAAA fd33:5692:1834:1000:be24:11ff:fe35:8257

; --- clients --------------------------------------------------------
printer     IN  A   192.168.8.241    ; Brother MFC-J4350DW, on Wi-Fi
printer     IN  AAAA fd33:5692:1834:1000:f64e:b4ff:feae:5d38 ; Brother MFC-J4350DW, on Wi-Fi

; --- aliases --------------------------------------------------------
dns         IN  CNAME themis.home.
ca          IN  CNAME pistis.home.
pve         IN  CNAME lenora.home.

; --- delegations ----------------------------------------------------
openstack   IN  NS  pythia.home.     ; openstack.home - the Proxmox lab, api backend
