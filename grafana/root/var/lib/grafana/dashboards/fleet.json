{
  "uid": "homelab-fleet",
  "title": "Fleet",
  "tags": [
    "homelab",
    "fleet"
  ],
  "description": "Every enrolled host, plus scrape and log-shipping health. Managed from homelab/grafana.",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "graphTooltip": 1,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "1m",
  "timezone": "browser",
  "panels": [
    {
      "type": "row",
      "title": "Fleet",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "type": "table",
      "title": "Hosts",
      "datasource": {
        "type": "datasource",
        "uid": "${prom}"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 10,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "datasource",
            "uid": "${prom}"
          },
          "editorMode": "code",
          "expr": "up{job=\"node\"}",
          "legendFormat": "{{role}}",
          "range": false,
          "instant": true,
          "refId": "A"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "job": true
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Value"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "options": {
                      "0": {
                        "color": "red",
                        "text": "DOWN"
                      }
                    },
                    "type": "value"
                  },
                  {
                    "options": {
                      "1": {
                        "color": "green",
                        "text": "UP"
                      }
                    },
                    "type": "value"
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              },
              {
                "id": "displayName",
                "value": "state"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "desc": false,
            "displayName": "role"
          }
        ]
      },
      "description": "Every enrolled host. Keep in step with FLEET in ca/scripts/enrol.sh and the node job in prometheus.yml - a host missing from either is unmonitored."
    },
    {
      "type": "timeseries",
      "title": "CPU busy",
      "datasource": {
        "type": "datasource",
        "uid": "${prom}"
      },
      "gridPos": {
        "x": 10,
        "y": 1,
        "w": 7,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "datasource",
            "uid": "${prom}"
          },
          "editorMode": "code",
          "expr": "100 * (1 - avg by (role) (rate(node_cpu_seconds_total{job=\"node\",mode=\"idle\"}[5m])))",
          "legendFormat": "{{role}}",
          "range": true,
          "instant": false,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 8,
            "lineWidth": 1,
            "showPoints": "never",
            "spanNulls": true
          },
          "color": {
            "mode": "palette-classic"
          },
          "unit": "percent",
          "min": 0,
          "max": 100
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Memory used",
      "datasource": {
        "type": "datasource",
        "uid": "${prom}"
      },
      "gridPos": {
        "x": 17,
        "y": 1,
        "w": 7,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "datasource",
            "uid": "${prom}"
          },
          "editorMode": "code",
          "expr": "100 * (1 - node_memory_MemAvailable_bytes{job=\"node\"} / node_memory_MemTotal_bytes{job=\"node\"})",
          "legendFormat": "{{role}}",
          "range": true,
          "instant": false,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 8,
            "lineWidth": 1,
            "showPoints": "never",
            "spanNulls": true
          },
          "color": {
            "mode": "palette-classic"
          },
          "unit": "percent",
          "min": 0,
          "max": 100
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "delphi runs high by design - ~2.3M RPZ entries plus caches in 6GB."
    },
    {
      "type": "timeseries",
      "title": "Root filesystem free",
      "datasource": {
        "type": "datasource",
        "uid": "${prom}"
      },
      "gridPos": {
        "x": 0,
        "y": 10,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "datasource",
            "uid": "${prom}"
          },
          "editorMode": "code",
          "expr": "100 * node_filesystem_avail_bytes{job=\"node\",mountpoint=\"/\"} / node_filesystem_size_bytes{job=\"node\",mountpoint=\"/\"}",
          "legendFormat": "{{role}}",
          "range": true,
          "instant": false,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 8,
            "lineWidth": 1,
            "showPoints": "never",
            "spanNulls": true
          },
          "color": {
            "mode": "palette-classic"
          },
          "unit": "percent",
          "min": 0,
          "max": 100
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Failed systemd units",
      "datasource": {
        "type": "datasource",
        "uid": "${prom}"
      },
      "gridPos": {
        "x": 12,
        "y": 10,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "datasource",
            "uid": "${prom}"
          },
          "editorMode": "code",
          "expr": "sum by (role) (node_systemd_unit_state{job=\"node\",state=\"failed\"})",
          "legendFormat": "{{role}}",
          "range": true,
          "instant": false,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 8,
            "lineWidth": 1,
            "showPoints": "never",
            "spanNulls": true
          },
          "color": {
            "mode": "palette-classic"
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "Any non-zero line is a unit that gave up. The per-unit name is in the alert, or on the host with systemctl --failed."
    },
    {
      "type": "timeseries",
      "title": "Load average (1m)",
      "datasource": {
        "type": "datasource",
        "uid": "${prom}"
      },
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "datasource": {
            "type": "datasource",
            "uid": "${prom}"
          },
          "editorMode": "code",
          "expr": "node_load1{job=\"node\"}",
          "legendFormat": "{{role}}",
          "range": true,
          "instant": false,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 8,
            "lineWidth": 1,
            "showPoints": "never",
            "spanNulls": true
          },
          "color": {
            "mode": "palette-classic"
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Network throughput",
      "datasource": {
        "type": "datasource",
        "uid": "${prom}"
      },
      "gridPos": {
        "x": 8,
        "y": 18,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "datasource": {
            "type": "datasource",
            "uid": "${prom}"
          },
          "editorMode": "code",
          "expr": "sum by (role) (rate(node_network_receive_bytes_total{job=\"node\",device!~\"lo|veth.*\"}[5m]))",
          "legendFormat": "{{role}} in",
          "range": true,
          "instant": false,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "datasource",
            "uid": "${prom}"
          },
          "editorMode": "code",
          "expr": "-sum by (role) (rate(node_network_transmit_bytes_total{job=\"node\",device!~\"lo|veth.*\"}[5m]))",
          "legendFormat": "{{role}} out",
          "range": true,
          "instant": false,
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 8,
            "lineWidth": 1,
            "showPoints": "never",
            "spanNulls": true
          },
          "color": {
            "mode": "palette-classic"
          },
          "unit": "Bps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Uptime",
      "datasource": {
        "type": "datasource",
        "uid": "${prom}"
      },
      "gridPos": {
        "x": 16,
        "y": 18,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "datasource": {
            "type": "datasource",
            "uid": "${prom}"
          },
          "editorMode": "code",
          "expr": "time() - node_boot_time_seconds{job=\"node\"}",
          "legendFormat": "{{role}}",
          "range": true,
          "instant": false,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 8,
            "lineWidth": 1,
            "showPoints": "never",
            "spanNulls": true
          },
          "color": {
            "mode": "palette-classic"
          },
          "unit": "s",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "row",
      "title": "Scrape health",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 25,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "type": "table",
      "title": "Targets",
      "datasource": {
        "type": "datasource",
        "uid": "${prom}"
      },
      "gridPos": {
        "x": 0,
        "y": 26,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "datasource",
            "uid": "${prom}"
          },
          "editorMode": "code",
          "expr": "up",
          "legendFormat": "",
          "range": false,
          "instant": true,
          "refId": "A"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "job": true
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Value"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "options": {
                      "0": {
                        "color": "red",
                        "text": "DOWN"
                      }
                    },
                    "type": "value"
                  },
                  {
                    "options": {
                      "1": {
                        "color": "green",
                        "text": "UP"
                      }
                    },
                    "type": "value"
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              },
              {
                "id": "displayName",
                "value": "state"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "desc": false,
            "displayName": "role"
          }
        ]
      },
      "description": "Every job, not just node. The pve job is known-broken: the prometheus-pve-exporter on 127.0.0.1:9221 is not running, and the alerts deliberately exclude it so it does not sit permanently firing."
    },
    {
      "type": "timeseries",
      "title": "Scrape duration",
      "datasource": {
        "type": "datasource",
        "uid": "${prom}"
      },
      "gridPos": {
        "x": 12,
        "y": 26,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "datasource",
            "uid": "${prom}"
          },
          "editorMode": "code",
          "expr": "scrape_duration_seconds",
          "legendFormat": "{{job}} {{instance}}",
          "range": true,
          "instant": false,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 8,
            "lineWidth": 1,
            "showPoints": "never",
            "spanNulls": true
          },
          "color": {
            "mode": "palette-classic"
          },
          "unit": "s",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "A scrape creeping towards the 30s interval will start missing samples."
    },
    {
      "type": "timeseries",
      "title": "Textfile collector errors",
      "datasource": {
        "type": "datasource",
        "uid": "${prom}"
      },
      "gridPos": {
        "x": 0,
        "y": 35,
        "w": 12,
        "h": 6
      },
      "targets": [
        {
          "datasource": {
            "type": "datasource",
            "uid": "${prom}"
          },
          "editorMode": "code",
          "expr": "node_textfile_scrape_error{job=\"node\"}",
          "legendFormat": "{{role}}",
          "range": true,
          "instant": false,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 8,
            "lineWidth": 1,
            "showPoints": "never",
            "spanNulls": true
          },
          "color": {
            "mode": "palette-classic"
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "1 means node-exporter could not parse a .prom file in /var/lib/node_exporter/textfile - the vpn-domain-sync or rpz-update metrics will be missing or wrong while this is set."
    },
    {
      "type": "timeseries",
      "title": "Log ingestion (alloy)",
      "datasource": {
        "type": "datasource",
        "uid": "${prom}"
      },
      "gridPos": {
        "x": 12,
        "y": 35,
        "w": 12,
        "h": 6
      },
      "targets": [
        {
          "datasource": {
            "type": "datasource",
            "uid": "${prom}"
          },
          "editorMode": "code",
          "expr": "sum by (role) (rate(loki_write_sent_entries_total{job=\"alloy\"}[5m]))",
          "legendFormat": "{{role}}",
          "range": true,
          "instant": false,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 8,
            "lineWidth": 1,
            "showPoints": "never",
            "spanNulls": true
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "Journal lines shipped to Loki. A host flatlining at zero has stopped shipping."
    }
  ],
  "templating": {
    "list": [
      {
        "name": "prom",
        "label": "Prometheus",
        "type": "datasource",
        "query": "prometheus",
        "hide": 2,
        "current": {},
        "refresh": 1
      }
    ]
  }
}
