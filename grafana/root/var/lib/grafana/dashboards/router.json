          "expr": "sum by (mac) (count_over_time({host=\"router\", identifier=\"kernel\"} |= \"WLAN station disconnected\" | regexp \"caller:(?P<cause>[A-Za-z_]+)\\\\+.*from (?P<band>[0-9.]+)Ghz Wifi radio, MAC-address: (?P<mac>[0-9a-f:]+), reason=(?P<reason>[0-9]+)\" | cause = \"ap_mlme_deauth_req_action\" [$__auto]))",
          "refId": "A",
