    {
      "type": "stat",
      "title": "Tunnel handshake age",
      "description": "Seconds since each WireGuard tunnel last handshook. Keepalive is 25 s, so anything past about 3 minutes means the tunnel is down.",
      "datasource": {
        "type": "datasource",
        "uid": "${prom}"
      },
      "gridPos": {
        "x": 12,
        "y": 22,
        "w": 12,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "datasource",
            "uid": "${prom}"
          },
          "editorMode": "code",
          "expr": "time() - homelab_router_wireguard_latest_handshake_seconds",
          "refId": "A",
          "legendFormat": "{{tunnel}}",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 180
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name"
      }
