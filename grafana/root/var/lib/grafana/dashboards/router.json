        "type": "datasource",
        "uid": "${prom}"
      },
      "gridPos": {
        "x": 12,
        "y": 26,
        "w": 12,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "datasource",
            "uid": "${prom}"
          },
          "editorMode": "code",
          "expr": "rate(homelab_router_wireguard_bytes_total{direction=\"rx\"}[5m]) * 8",
          "refId": "A",
          "legendFormat": "{{tunnel}} in",
          "range": true,
          "instant": false
        },
        {
          "datasource": {
            "type": "datasource",
            "uid": "${prom}"
          },
          "editorMode": "code",
          "expr": "-rate(homelab_router_wireguard_bytes_total{direction=\"tx\"}[5m]) * 8",
          "refId": "B",
          "legendFormat": "{{tunnel}} out",
          "range": true,
          "instant": false
        }
