    {
      "type": "table",
      "title": "Clients",
      "description": "Every associated link now. An MLO client has one row per band, each with its own link MAC; mac is the client's own address, recovered from the router's log, and client is its DHCP name. 'unknown' means no name in the leases, or an MLO link not seen associating since the router's log last rolled. Signal: above -65 is good, below -80 is marginal.",
      "datasource": {
        "type": "datasource",
        "uid": "${prom}"
      },
      "gridPos": {
        "x": 0,
        "y": 39,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "datasource",
            "uid": "${prom}"
          },
          "editorMode": "code",
          "expr": "homelab_router_wifi_client_signal_dbm",
          "refId": "A",
          "legendFormat": "",
          "range": false,
          "instant": true
        },
        {
          "datasource": {
            "type": "datasource",
            "uid": "${prom}"
          },
          "editorMode": "code",
          "expr": "homelab_router_wifi_client_rate_mbps{direction=\"rx\"}",
          "refId": "B",
          "legendFormat": "",
          "range": false,
          "instant": true
        },
        {
          "datasource": {
            "type": "datasource",
            "uid": "${prom}"
          },
          "editorMode": "code",
          "expr": "homelab_router_wifi_client_rate_mbps{direction=\"tx\"}",
          "refId": "C",
          "legendFormat": "",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Value #A"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "signal"
              },
              {
                "id": "unit",
                "value": "dBm"
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "red",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": -80
                    },
                    {
                      "color": "green",
                      "value": -65
                    }
                  ]
                }
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Value #B"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "rx Mb/s"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Value #C"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "tx Mb/s"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "client",
            "desc": false
          }
        ]
      },
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "instance": true,
              "job": true,
              "role": true,
              "direction": true
            },
            "indexByName": {
              "client": 0,
              "band": 1,
              "iface": 2,
              "mac": 3
            }
          }
        }
      ]
    },
