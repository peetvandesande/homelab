    {
      "type": "timeseries",
      "title": "Disconnects",
      "description": "Every client disconnect, by band and by what ended it, from the driver's log in Loki. ap_peer_disassoc_action / ap_peer_deauth_action: the client left. MacTableMaintenance: the router timed a quiet client out (reason 3) - the iPhone drops of October 2026 were mostly these. txcmdsu_dbg_init: the client left (reason 8). Rejected joins are in their own panel.",
      "datasource": {
        "type": "datasource",
        "uid": "${loki}"
      },
      "gridPos": {
        "x": 0,
        "y": 31,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "datasource",
            "uid": "${loki}"
          },
          "editorMode": "code",
          "expr": "sum by (band, cause) (count_over_time({host=\"router\", identifier=\"kernel\"} |= \"WLAN station disconnected\" | regexp \"caller:(?P<cause>[A-Za-z_]+)\\\\+.*from (?P<band>[0-9.]+)Ghz Wifi radio, MAC-address: (?P<mac>[0-9a-f:]+), reason=(?P<reason>[0-9]+)\" | cause != \"ap_mlme_deauth_req_action\" [$__auto]))",
          "refId": "A",
          "legendFormat": "{{band}} GHz {{cause}}",
          "queryType": "range"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "lineWidth": 1,
            "showPoints": "never"
          },
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Clients per band",
      "description": "Associated clients on each radio. An MLO client counts once on each band it has a link on.",
      "datasource": {
        "type": "datasource",
        "uid": "${prom}"
      },
      "gridPos": {
        "x": 12,
        "y": 31,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "datasource",
            "uid": "${prom}"
          },
          "editorMode": "code",
          "expr": "homelab_router_wifi_clients",
          "refId": "A",
          "legendFormat": "{{band}} GHz",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 40,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          },
          "decimals": 0
