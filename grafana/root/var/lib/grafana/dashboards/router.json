{
  "uid": "homelab-router",
  "title": "Router and ONT",
  "tags": [
    "homelab",
    "router"
  ],
  "description": "The GL-BE14000 and the XGS-PON stick in it: optics, line errors, WAN, tunnels, Wi-Fi and the router itself. Metrics from homelab/router-metrics, logs from Loki. Managed from homelab/grafana.",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "graphTooltip": 1,
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "refresh": "1m",
  "timezone": "browser",
  "templating": {
    "list": [
      {
        "name": "prom",
        "label": "Prometheus",
        "type": "datasource",
        "query": "prometheus",
        "hide": 2,
        "current": {},
        "refresh": 1
      },
      {
        "name": "loki",
        "label": "Loki",
        "type": "datasource",
        "query": "loki",
        "hide": 2,
        "current": {},
        "refresh": 1
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "ONT (XGS-PON)",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      }
    },
    {
      "type": "stat",
      "title": "PLOAM state",
      "description": "51 is O5.1, operational. Anything else means no data path at all - see router/ORANGE.md 'Diagnosing the PON'. 23 (O2.3) looping with deact_onu climbing is the marginal-upstream signature.",
      "datasource": {
        "type": "datasource",
        "uid": "${prom}"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "datasource",
            "uid": "${prom}"
          },
          "editorMode": "code",
          "expr": "homelab_ont_ploam_state",
          "refId": "A",
          "legendFormat": "",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 51
              },
              {
                "color": "red",
                "value": 52
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "51": {
                  "text": "O5.1 up",
                  "color": "green"
                }
              }
            },
            {
              "type": "range",
              "options": {
                "from": 0,
                "to": 50,
                "result": {
                  "color": "red"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      }
    },
    {
      "type": "stat",
      "title": "In this state for",
      "description": "Time since the PLOAM state last changed - effectively time since the link last came up. A short value you did not cause is a drop.",
      "datasource": {
        "type": "datasource",
        "uid": "${prom}"
      },
      "gridPos": {
        "x": 4,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "datasource",
            "uid": "${prom}"
          },
          "editorMode": "code",
          "expr": "homelab_ont_ploam_state_seconds",
          "refId": "A",
          "legendFormat": "",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      }
    },
    {
      "type": "stat",
      "title": "FEC locked",
      "description": "Forward error correction lock, downstream and upstream. Both must be locked.",
      "datasource": {
        "type": "datasource",
        "uid": "${prom}"
      },
      "gridPos": {
        "x": 8,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "datasource",
            "uid": "${prom}"
          },
          "editorMode": "code",
          "expr": "homelab_ont_fec_locked",
          "refId": "A",
          "legendFormat": "{{direction}}",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "yes",
                  "color": "green"
                },
                "0": {
                  "text": "NO",
                  "color": "red"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name"
      }
    },
    {
      "type": "stat",
      "title": "Rx power",
      "description": "Light arriving from the OLT. Healthy is about -19 dBm. Ranging broke at -23 dBm on 7 October (a half-seated fibre) while the stick raised no alarm - its own window is -29 to -7. Orange from -21, red from -23: clean or reseat the connector.",
      "datasource": {
        "type": "datasource",
        "uid": "${prom}"
      },
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "datasource",
            "uid": "${prom}"
          },
          "editorMode": "code",
          "expr": "homelab_ont_rx_power_dbm",
          "refId": "A",
          "legendFormat": "",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "dBm",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": -23
              },
              {
                "color": "green",
                "value": -21
              },
              {
                "color": "red",
                "value": -8
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value"
      }
    },
    {
      "type": "stat",
      "title": "Tx power",
      "description": "Light the stick sends. About 7.3 dBm; the Livebox ran 5.9.",
      "datasource": {
        "type": "datasource",
        "uid": "${prom}"
      },
      "gridPos": {
        "x": 16,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "datasource",
            "uid": "${prom}"
          },
          "editorMode": "code",
          "expr": "homelab_ont_tx_power_dbm",
          "refId": "A",
          "legendFormat": "",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "dBm",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value"
      }
    },
    {
      "type": "stat",
      "title": "Stick temperature",
      "description": "About 45 \u00b0C idle, 60 \u00b0C loaded. The router's fan only starts at 70 \u00b0C (ORANGE.md open item 3).",
      "datasource": {
        "type": "datasource",
        "uid": "${prom}"
      },
      "gridPos": {
        "x": 20,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "datasource",
            "uid": "${prom}"
          },
          "editorMode": "code",
          "expr": "homelab_ont_temperature_celsius",
          "refId": "A",
          "legendFormat": "",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 70
              },
              {
                "color": "red",
                "value": 80
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value"
      }
    },
    {
      "type": "timeseries",
      "title": "Optical power",
      "description": "Rx and Tx over time. A step change in Rx is the fibre or connector; a slow drift is dirt or a bend.",
      "datasource": {
        "type": "datasource",
        "uid": "${prom}"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "datasource",
            "uid": "${prom}"
          },
          "editorMode": "code",
          "expr": "homelab_ont_rx_power_dbm",
          "refId": "A",
          "legendFormat": "Rx",
          "range": true,
          "instant": false
        },
        {
          "datasource": {
            "type": "datasource",
            "uid": "${prom}"
          },
          "editorMode": "code",
          "expr": "homelab_ont_tx_power_dbm",
          "refId": "B",
          "legendFormat": "Tx",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "dBm",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Stick temperature and supply",
      "description": "Temperature follows load; voltage should sit flat at about 3.23 V.",
      "datasource": {
        "type": "datasource",
        "uid": "${prom}"
      },
      "gridPos": {
        "x": 12,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "datasource",
            "uid": "${prom}"
          },
          "editorMode": "code",
          "expr": "homelab_ont_temperature_celsius",
          "refId": "A",
          "legendFormat": "temperature",
          "range": true,
          "instant": false
        },
        {
          "datasource": {
            "type": "datasource",
            "uid": "${prom}"
          },
          "editorMode": "code",
          "expr": "homelab_ont_voltage_volts",
          "refId": "B",
          "legendFormat": "voltage",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "voltage"
            },
            "properties": [
              {
                "id": "unit",
                "value": "volt"
              },
              {
                "id": "custom.axisPlacement",
                "value": "right"
              }
            ]
          }
        ]
      }
    },
    {
      "type": "timeseries",
      "title": "Line errors",
      "description": "Per 5 minutes. Corrected FEC codewords are the line working as designed; uncorrected ones, BIP errors and lost words are data damaged on the fibre. LODS is a loss of downstream sync - a momentary outage. A few on link-up are normal.",
      "datasource": {
        "type": "datasource",
        "uid": "${prom}"
      },
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "datasource",
            "uid": "${prom}"
          },
          "editorMode": "code",
          "expr": "increase(homelab_ont_fec_codewords_corrected_total[5m])",
          "refId": "A",
          "legendFormat": "FEC corrected",
          "range": true,
          "instant": false
        },
        {
          "datasource": {
            "type": "datasource",
            "uid": "${prom}"
          },
          "editorMode": "code",
          "expr": "increase(homelab_ont_fec_codewords_uncorrected_total[5m])",
          "refId": "B",
          "legendFormat": "FEC uncorrected",
          "range": true,
          "instant": false
        },
        {
          "datasource": {
            "type": "datasource",
            "uid": "${prom}"
          },
          "editorMode": "code",
          "expr": "increase(homelab_ont_bip_errors_total[5m])",
          "refId": "C",
          "legendFormat": "BIP errors",
          "range": true,
          "instant": false
        },
        {
          "datasource": {
            "type": "datasource",
            "uid": "${prom}"
          },
          "editorMode": "code",
          "expr": "increase(homelab_ont_lost_words_total[5m])",
          "refId": "D",
          "legendFormat": "lost words",
          "range": true,
          "instant": false
        },
        {
          "datasource": {
            "type": "datasource",
            "uid": "${prom}"
          },
          "editorMode": "code",
          "expr": "increase(homelab_ont_lods_events_total[5m])",
          "refId": "E",
          "legendFormat": "LODS",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "lineWidth": 1,
            "showPoints": "never"
          },
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "PLOAM messages",
      "description": "Per 5 minutes. Silent while the link is up. assign_onu_id, ser_no and deact_onu climbing together with no ranging_time is the marginal-upstream loop from ORANGE.md: check Rx power.",
      "datasource": {
        "type": "datasource",
        "uid": "${prom}"
      },
      "gridPos": {
        "x": 12,
        "y": 13,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "datasource",
            "uid": "${prom}"
          },
          "editorMode": "code",
          "expr": "increase(homelab_ont_ploam_messages_total[5m])",
          "refId": "A",
          "legendFormat": "{{direction}} {{type}}",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "lineWidth": 1,
            "showPoints": "never"
          },
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "type": "row",
      "title": "WAN and tunnels",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 24,
        "h": 1
      }
    },
    {
      "type": "timeseries",
      "title": "Orange throughput",
      "description": "The Orange VLAN (eth1.832), both directions, everything the house sends and receives.",
      "datasource": {
        "type": "datasource",
        "uid": "${prom}"
      },
      "gridPos": {
        "x": 0,
        "y": 22,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "datasource",
            "uid": "${prom}"
          },
          "editorMode": "code",
          "expr": "rate(homelab_router_wan_bytes_total{direction=\"rx\"}[5m]) * 8",
          "refId": "A",
          "legendFormat": "down",
          "range": true,
          "instant": false
        },
        {
          "datasource": {
            "type": "datasource",
            "uid": "${prom}"
          },
          "editorMode": "code",
          "expr": "-rate(homelab_router_wan_bytes_total{direction=\"tx\"}[5m]) * 8",
          "refId": "B",
          "legendFormat": "up",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bps",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "IPv6 prefix",
      "description": "Whether Orange has delegated the /56. NO with wan6 up is the IAID trap in router/ORANGE.md, and takes both WireGuard tunnels down with it - their endpoints are IPv6.",
      "datasource": {
        "type": "datasource",
        "uid": "${prom}"
      },
      "gridPos": {
        "x": 12,
        "y": 22,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "datasource",
            "uid": "${prom}"
          },
          "editorMode": "code",
          "expr": "homelab_router_ipv6_prefix_delegated",
          "refId": "A",
          "legendFormat": "",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "yes",
                  "color": "green"
                },
                "0": {
                  "text": "NO",
                  "color": "red"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      }
    },
    {
      "type": "stat",
      "title": "wan6 up",
      "description": "netifd's view of the DHCPv6 interface.",
      "datasource": {
        "type": "datasource",
        "uid": "${prom}"
      },
      "gridPos": {
        "x": 16,
        "y": 22,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "datasource",
            "uid": "${prom}"
          },
          "editorMode": "code",
          "expr": "homelab_router_wan6_up",
          "refId": "A",
          "legendFormat": "",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "yes",
                  "color": "green"
                },
                "0": {
                  "text": "NO",
                  "color": "red"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      }
    },
    {
      "type": "stat",
      "title": "Collection",
      "description": "Whether lenora reached the router and the router reached the ONT on the last run (homelab/router-metrics).",
      "datasource": {
        "type": "datasource",
        "uid": "${prom}"
      },
      "gridPos": {
        "x": 20,
        "y": 22,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "datasource",
            "uid": "${prom}"
          },
          "editorMode": "code",
          "expr": "homelab_router_metrics_up",
          "refId": "A",
          "legendFormat": "router",
          "range": false,
          "instant": true
        },
        {
          "datasource": {
            "type": "datasource",
            "uid": "${prom}"
          },
          "editorMode": "code",
          "expr": "homelab_ont_up",
          "refId": "B",
          "legendFormat": "ONT",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "yes",
                  "color": "green"
                },
                "0": {
                  "text": "NO",
                  "color": "red"
                }
              }
            }
          ]
        },
        "overrides": []
      },
