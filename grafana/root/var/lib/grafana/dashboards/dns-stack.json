{
  "uid": "homelab-dns",
  "title": "DNS stack",
  "description": "themis (dnsdist) -> delphi (recursor + RPZ) -> pythia (authoritative), plus the VPN-domain shunt to the router. Managed from homelab/grafana.",
  "tags": [
    "dns",
    "homelab"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "1m",
  "timezone": "browser",
  "graphTooltip": 1,
  "panels": [
    {
      "type": "row",
      "title": "Is it working?",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "type": "stat",
      "title": "dnsdist (themis)",
      "datasource": {
        "type": "datasource",
        "uid": "${prom}"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 3,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "datasource",
            "uid": "${prom}"
          },
          "editorMode": "code",
          "expr": "up{job=\"dns\",component=\"dnsdist\"}",
          "legendFormat": "",
          "range": false,
          "instant": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "options": {
                "0": {
                  "color": "red",
                  "index": 1,
                  "text": "DOWN"
                }
              },
              "type": "value"
            },
            {
              "options": {
                "1": {
                  "color": "green",
                  "index": 0,
                  "text": "UP"
                }
              },
              "type": "value"
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "description": "The only address clients talk to. Down means the LAN has no DNS."
    },
    {
      "type": "stat",
      "title": "recursor (delphi)",
      "datasource": {
        "type": "datasource",
        "uid": "${prom}"
      },
      "gridPos": {
        "x": 3,
        "y": 1,
        "w": 3,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "datasource",
            "uid": "${prom}"
          },
          "editorMode": "code",
          "expr": "up{job=\"dns\",component=\"recursor\"}",
          "legendFormat": "",
          "range": false,
          "instant": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "options": {
                "0": {
                  "color": "red",
                  "index": 1,
                  "text": "DOWN"
                }
              },
              "type": "value"
            },
            {
              "options": {
                "1": {
                  "color": "green",
                  "index": 0,
                  "text": "UP"
                }
              },
              "type": "value"
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "description": "All recursion and all RPZ filtering."
    },
    {
      "type": "stat",
      "title": "auth (pythia)",
      "datasource": {
        "type": "datasource",
        "uid": "${prom}"
      },
      "gridPos": {
        "x": 6,
        "y": 1,
        "w": 3,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "datasource",
            "uid": "${prom}"
          },
          "editorMode": "code",
          "expr": "up{job=\"dns\",component=\"auth\"}",
          "legendFormat": "",
          "range": false,
          "instant": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "options": {
                "0": {
                  "color": "red",
                  "index": 1,
                  "text": "DOWN"
                }
              },
              "type": "value"
            },
            {
              "options": {
                "1": {
                  "color": "green",
                  "index": 0,
                  "text": "UP"
                }
              },
              "type": "value"
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "description": "Authoritative for home. and the split-horizon overrides."
    },
    {
      "type": "stat",
      "title": "Backends",
      "datasource": {
        "type": "datasource",
        "uid": "${prom}"
      },
      "gridPos": {
        "x": 9,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "datasource",
            "uid": "${prom}"
          },
          "editorMode": "code",
          "expr": "dnsdist_server_status",
          "legendFormat": "{{server}}",
          "range": false,
          "instant": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "options": {
                "0": {
                  "color": "red",
                  "index": 1,
                  "text": "DOWN"
                }
              },
              "type": "value"
            },
            {
              "options": {
                "1": {
                  "color": "green",
                  "index": 0,
                  "text": "UP"
                }
              },
              "type": "value"
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "description": "delphi is the filtering path; wgclient2-dns and router-dns-vpn-uk are the VPN-domain shunt and its fallback."
    },
    {
      "type": "stat",
      "title": "VPN shunt",
      "datasource": {
        "type": "datasource",
        "uid": "${prom}"
      },
      "gridPos": {
        "x": 15,
        "y": 1,
        "w": 5,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "datasource",
            "uid": "${prom}"
          },
          "editorMode": "code",
          "expr": "sum(vpn_domain_sync_domains)",
          "legendFormat": "domains",
          "range": false,
          "instant": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "description": "Domains Themis hands to the router so its policy routing fires. Zero means the tunnel is never used."
    },
    {
      "type": "stat",
      "title": "Shunt sync",
      "datasource": {
        "type": "datasource",
        "uid": "${prom}"
      },
      "gridPos": {
        "x": 20,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "datasource",
            "uid": "${prom}"
          },
          "editorMode": "code",
          "expr": "vpn_domain_sync_success",
          "legendFormat": "",
          "range": false,
          "instant": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "options": {
                "0": {
                  "color": "red",
                  "index": 1,
                  "text": "FAILING"
                }
              },
              "type": "value"
            },
            {
              "options": {
                "1": {
                  "color": "green",
                  "index": 0,
                  "text": "OK"
                }
              },
              "type": "value"
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "description": "Hourly pull of the VPN domain policy from the router."
    },
    {
      "type": "row",
      "title": "Query flow",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Queries through Themis",
      "datasource": {
        "type": "datasource",
        "uid": "${prom}"
      },
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "datasource",
            "uid": "${prom}"
          },
          "editorMode": "code",
          "expr": "rate(dnsdist_queries[5m])",
          "legendFormat": "queries",
          "range": true,
          "instant": false,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "datasource",
            "uid": "${prom}"
          },
          "editorMode": "code",
          "expr": "rate(dnsdist_responses[5m])",
          "legendFormat": "responses from backends",
          "range": true,
          "instant": false,
          "refId": "B"
        },
        {
          "datasource": {
            "type": "datasource",
            "uid": "${prom}"
          },
          "editorMode": "code",
          "expr": "rate(dnsdist_self_answered[5m])",
          "legendFormat": "answered by dnsdist itself",
          "range": true,
          "instant": false,
          "refId": "C"
        },
        {
          "datasource": {
            "type": "datasource",
            "uid": "${prom}"
          },
          "editorMode": "code",
          "expr": "rate(dnsdist_servfail_responses[5m])",
          "legendFormat": "SERVFAIL",
          "range": true,
          "instant": false,
          "refId": "D"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 8,
            "lineWidth": 1,
            "showPoints": "never",
            "spanNulls": true
          },
          "color": {
            "mode": "palette-classic"
          },
          "unit": "qps",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "Everything on the LAN enters here, over Do53, DoT or DoH."
    },
    {
      "type": "timeseries",
      "title": "Cache hit rate per policy set",
      "datasource": {
        "type": "datasource",
        "uid": "${prom}"
      },
      "gridPos": {
        "x": 12,
        "y": 6,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "datasource",
            "uid": "${prom}"
          },
          "editorMode": "code",
          "expr": "100 * rate(dnsdist_pool_cache_hits[15m]) / clamp_min(rate(dnsdist_pool_cache_hits[15m]) + rate(dnsdist_pool_cache_misses[15m]), 0.0001)",
          "legendFormat": "{{pool}}",
          "range": true,
          "instant": false,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 8,
            "lineWidth": 1,
            "showPoints": "never",
            "spanNulls": true
          },
          "color": {
            "mode": "palette-classic"
          },
          "unit": "percent",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "One cache per pool, deliberately: dnsdist keys the cache on the question and not the policy tag, so a shared cache would serve a kids NXDOMAIN to an adult device. vpn-* pools have no cache on purpose and will not appear."
    },
    {
      "type": "timeseries",
      "title": "Where queries go",
      "datasource": {
        "type": "datasource",
        "uid": "${prom}"
      },
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "datasource",
            "uid": "${prom}"
          },
          "editorMode": "code",
          "expr": "rate(dnsdist_server_queries[5m])",
          "legendFormat": "{{server}}",
          "range": true,
          "instant": false,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 18,
            "lineWidth": 1,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          },
          "color": {
            "mode": "palette-classic"
          },
          "unit": "qps",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "delphi is the normal path. Traffic to wgclient2-dns is the VPN-domain shunt - BBC and friends being resolved through the UK tunnel so the router's ipset fills."
    },
    {
      "type": "timeseries",
      "title": "Encrypted transports",
      "datasource": {
        "type": "datasource",
        "uid": "${prom}"
      },
      "gridPos": {
        "x": 12,
        "y": 14,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "datasource",
            "uid": "${prom}"
          },
          "editorMode": "code",
          "expr": "rate(dnsdist_frontend_tlsqueries[5m])",
          "legendFormat": "DoT/DoH queries",
          "range": true,
          "instant": false,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "datasource",
            "uid": "${prom}"
          },
          "editorMode": "code",
          "expr": "rate(dnsdist_frontend_tlshandshakefailures[5m])",
          "legendFormat": "TLS handshake failures",
          "range": true,
          "instant": false,
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 8,
            "lineWidth": 1,
            "showPoints": "never",
            "spanNulls": true
          },
          "color": {
            "mode": "palette-classic"
          },
          "unit": "qps",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "DoT :853 and DoH :443, off the lab CA. Same rule chain as Do53."
    },
    {
      "type": "row",
      "title": "Filtering",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 22,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Blocks per feed",
      "datasource": {
        "type": "datasource",
        "uid": "${prom}"
      },
      "gridPos": {
        "x": 0,
        "y": 23,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "datasource",
            "uid": "${prom}"
          },
          "editorMode": "code",
          "expr": "rate(pdns_recursor_policy_hits{policyname!=\"\"}[5m])",
          "legendFormat": "{{policyname}}",
          "range": true,
          "instant": false,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 18,
            "lineWidth": 1,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          },
          "color": {
            "mode": "palette-classic"
          },
          "unit": "qps",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "ads and malware apply to everyone; the rest only to clients Themis tagged into that policy set."
    },
    {
      "type": "timeseries",
      "title": "Feed size",
      "datasource": {
        "type": "datasource",
        "uid": "${prom}"
      },
      "gridPos": {
        "x": 12,
        "y": 23,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "datasource",
            "uid": "${prom}"
          },
          "editorMode": "code",
          "expr": "rpz_feed_lines",
          "legendFormat": "{{feed}}",
          "range": true,
          "instant": false,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 8,
            "lineWidth": 1,
            "showPoints": "never",
            "spanNulls": true
          },
          "color": {
            "mode": "palette-classic"
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "Lines in each installed feed. A sudden collapse is upstream serving something broken - the tripwire in rpz-feeds.conf should have refused it, so look at rpz_feed_ok too."
    },
    {
      "type": "timeseries",
      "title": "Feed staleness",
      "datasource": {
        "type": "datasource",
        "uid": "${prom}"
      },
      "gridPos": {
        "x": 0,
        "y": 31,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "datasource": {
            "type": "datasource",
            "uid": "${prom}"
          },
          "editorMode": "code",
          "expr": "(time() - rpz_feed_last_fresh_seconds) / 3600",
          "legendFormat": "{{feed}}",
          "range": true,
          "instant": false,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 8,
            "lineWidth": 1,
            "showPoints": "never",
            "spanNulls": true
          },
          "color": {
            "mode": "palette-classic"
          },
          "unit": "h",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "Hours since the feed was last confirmed current. rpz-update runs daily, so anything much past 24-48h means it has stopped refreshing and the recursor is serving a stale copy."
    },
    {
      "type": "timeseries",
      "title": "Policy outcomes",
      "datasource": {
        "type": "datasource",
        "uid": "${prom}"
      },
      "gridPos": {
        "x": 12,
        "y": 31,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "datasource": {
            "type": "datasource",
            "uid": "${prom}"
          },
          "editorMode": "code",
          "expr": "rate(pdns_recursor_policy_result_nxdomain[5m])",
          "legendFormat": "NXDOMAIN (blocked)",
          "range": true,
          "instant": false,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "datasource",
            "uid": "${prom}"
          },
          "editorMode": "code",
          "expr": "rate(pdns_recursor_policy_result_drop[5m])",
          "legendFormat": "dropped",
          "range": true,
          "instant": false,
          "refId": "B"
        },
        {
          "datasource": {
            "type": "datasource",
            "uid": "${prom}"
          },
          "editorMode": "code",
          "expr": "rate(pdns_recursor_policy_result_nodata[5m])",
          "legendFormat": "NODATA",
          "range": true,
          "instant": false,
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 8,
            "lineWidth": 1,
