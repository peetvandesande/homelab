{
  "uid": "esxi",
  "title": "ESXi - esther",
  "description": "esther (192.168.1.20), the ESXi host. Everything here comes from Loki: SMART pulled hourly by the relay on the loki container, syslog forwarded by ESXi over TLS. Managed from homelab/esxi and homelab/grafana.",
  "tags": [
    "esxi",
    "esther",
    "smart"
  ],
  "timezone": "browser",
  "editable": false,
  "graphTooltip": 1,
  "refresh": "5m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "schemaVersion": 41,
  "version": 1,
  "templating": {
    "list": [
      {
        "name": "loki",
        "label": "Loki",
        "type": "datasource",
        "query": "loki",
        "hide": 2,
        "refresh": 1,
        "current": {
          "selected": false,
          "text": "Loki",
          "value": "Loki"
        },
        "options": [],
        "regex": ""
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "links": [],
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "SMART (pulled hourly by esxi-smart.timer on the loki container)",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Health",
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "refId": "A",
          "expr": "last_over_time({host=\"esther\", job=\"esxi-smart\"} | logfmt | smart!=\"unavailable\" | label_format ok=`{{ if eq .health_status \"OK\" }}1{{ else }}0{{ end }}` | unwrap ok [2h]) by (model)",
          "queryType": "instant",
          "legendFormat": "{{model}}"
        }
      ],
      "description": "health_status as reported by esxcli. No data means the puller has not pushed in two hours - check esxi-smart.timer on 192.168.1.56.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "OK",
                  "color": "green"
                },
                "0": {
                  "text": "FAILING",
                  "color": "red"
                }
              }
            }
          ],
          "noValue": "no data"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "value_and_name",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "wideLayout": true,
        "showPercentChange": false
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Temperature",
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "gridPos": {
        "x": 6,
        "y": 1,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "refId": "A",
          "expr": "last_over_time({host=\"esther\", job=\"esxi-smart\"} | logfmt | smart!=\"unavailable\" | unwrap drive_temperature [2h]) by (model)",
          "queryType": "instant",
          "legendFormat": "{{model}}"
        }
      ],
      "description": "drive_temperature from the last pull. Thresholds are generic (amber at 45, red at 55); the NVMe's own limit is 82.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 45
              },
              {
                "color": "red",
                "value": 55
              }
            ]
          },
          "unit": "celsius",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "value_and_name",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "wideLayout": true,
        "showPercentChange": false
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Bad sectors",
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "refId": "A",
          "expr": "last_over_time({host=\"esther\", job=\"esxi-smart\"} | logfmt | smart!=\"unavailable\" | label_format bad=`{{ add (default 0 .reallocated_sector_count | int) (default 0 .pending_sector_reallocation_count | int) (default 0 .uncorrectable_sector_count | int) }}` | unwrap bad [2h]) by (model)",
          "queryType": "instant",
          "legendFormat": "{{model}}"
        }
      ],
      "description": "reallocated + pending + uncorrectable sector counts. Anything above zero on a spinning disk is worth a look; a rising count means replace it.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 10
              }
            ]
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "value_and_name",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "wideLayout": true,
        "showPercentChange": false
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Attributes below threshold",
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "gridPos": {
        "x": 18,
        "y": 1,
        "w": 3,
        "h": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "refId": "A",
          "expr": "sum(count_over_time({host=\"esther\", job=\"esxi-smart\"} |= \"below_threshold\" [2h]))",
          "queryType": "instant",
          "legendFormat": "lines"
        }
      ],
      "description": "Lines in the last two hours carrying below_threshold=. Zero is the healthy state. To see which: {host=\"esther\", job=\"esxi-smart\"} |= \"below_threshold\"",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "none",
                  "color": "green"
                }
              }
            }
          ],
          "noValue": "none"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "value_and_name",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "wideLayout": true,
        "showPercentChange": false
      }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Last pull",
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "gridPos": {
        "x": 21,
        "y": 1,
        "w": 3,
        "h": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "refId": "A",
          "expr": "{host=\"esther\", job=\"esxi-smart\"}",
          "queryType": "range",
          "maxLines": 1
        }
      ],
      "description": "When the puller last pushed a SMART line. Expect under an hour.",
      "fieldConfig": {
        "defaults": {
          "unit": "dateTimeFromNow",
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          },
          "noValue": "never"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/^Time$/",
          "values": false
        },
        "orientation": "auto",
        "textMode": "value",
        "colorMode": "none",
        "graphMode": "none",
        "justifyMode": "auto",
        "wideLayout": true,
        "showPercentChange": false
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Drive temperature",
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 16,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "refId": "A",
          "expr": "max_over_time({host=\"esther\", job=\"esxi-smart\"} | logfmt | smart!=\"unavailable\" | unwrap drive_temperature [2h]) by (model)",
          "queryType": "range",
          "legendFormat": "{{model}}"
        },
        {
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "refId": "B",
          "expr": "last_over_time({host=\"esther\", job=\"esxi-smart\"} | logfmt | smart!=\"unavailable\" | unwrap drive_temperature_threshold [2h]) by (model)",
          "queryType": "range",
          "legendFormat": "{{model}} limit"
        }
      ],
      "description": "One sample an hour, so the line is a two-hour rolling maximum. Dashed lines are the drive's own threshold where esxcli reports one (NVMe does; ATA disks usually do not).",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true,
            "lineInterpolation": "linear",
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "axisPlacement": "auto",
            "axisLabel": "",
            "gradientMode": "none",
            "thresholdsStyle": {
              "mode": "off"
            }
          },
          "unit": "celsius",
          "min": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".* limit$"
            },
            "properties": [
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    10,
                    10
                  ]
                }
              },
              {
                "id": "custom.fillOpacity",
                "value": 0
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 8,
      "type": "stat",
      "title": "Power-on time",
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "gridPos": {
        "x": 16,
        "y": 6,
        "w": 8,
        "h": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "refId": "A",
          "expr": "last_over_time({host=\"esther\", job=\"esxi-smart\"} | logfmt | smart!=\"unavailable\" | label_format hours=`{{ if .power_on_hours_raw }}{{ .power_on_hours_raw }}{{ else }}{{ .power_on_hours }}{{ end }}` | unwrap hours [2h]) by (model)",
          "queryType": "instant",
          "legendFormat": "{{model}}"
        }
      ],
      "description": "power_on_hours_raw where esxcli gives a raw value (ATA), otherwise the value as printed (NVMe).",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "unit": "dtdurationh",
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "value_and_name",
        "colorMode": "none",
        "graphMode": "none",
        "justifyMode": "auto",
        "wideLayout": true,
        "showPercentChange": false
      }
    },
    {
      "id": 9,
      "type": "stat",
      "title": "Power cycles",
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "gridPos": {
        "x": 16,
        "y": 11,
        "w": 8,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "refId": "A",
          "expr": "last_over_time({host=\"esther\", job=\"esxi-smart\"} | logfmt | smart!=\"unavailable\" | unwrap power_cycle_count [2h]) by (model)",
          "queryType": "instant",
          "legendFormat": "{{model}}"
        }
      ],
      "description": "",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "value_and_name",
        "colorMode": "none",
        "graphMode": "none",
        "justifyMode": "auto",
        "wideLayout": true,
        "showPercentChange": false
      }
    },
    {
      "id": 10,
      "type": "row",
      "title": "Syslog (vmsyslogd over TLS to the relay)",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Log volume by severity",
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "refId": "A",
          "expr": "sum by (level) (count_over_time({host=\"esther\", job=\"esxi-syslog\"}[$__auto]))",
