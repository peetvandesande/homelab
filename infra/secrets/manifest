# What lives in Bitwarden Secrets Manager and where infra/scripts/vault.py puts
# it locally. Names only: this repository is public.
#
# key                          project            kind  path                                 variable
#
# homelab-restricted holds what could rebuild trust in the lab or reach the
# internet connection, and the deploy runner is never given access to it.

# Certificate authority
ca/STEP_CA_KEY_PASSWORD        homelab-restricted env   ca/secrets.env                       STEP_CA_KEY_PASSWORD
ca/STEP_CA_JWK_PASSWORD        homelab-restricted env   ca/secrets.env                       STEP_CA_JWK_PASSWORD
ca/JWK_PROVISIONER             homelab-restricted env   ca/secrets.env                       JWK_PROVISIONER
ca/intermediate-g3.key         homelab-restricted file  repo:ca/intermediate/private/intermediate-g3.key -

# Orange fibre
router/ORANGE_LOGIN            homelab-restricted env   router/orange.env                    ORANGE_LOGIN
router/ORANGE_PASSWORD         homelab-restricted env   router/orange.env                    ORANGE_PASSWORD

# WireGuard: keys and the configs filled in from them
wireguard/wg1.key              homelab-restricted file  wireguard/wg1.key                    -
wireguard/wg1.pub              homelab-restricted file  wireguard/wg1.pub                    -
wireguard/wg2.key              homelab-restricted file  wireguard/wg2.key                    -
wireguard/wg2.pub              homelab-restricted file  wireguard/wg2.pub                    -
wireguard/home-jennie.psk      homelab-restricted file  wireguard/home-jennie.psk            -
wireguard/jennie.psk           homelab-restricted file  wireguard/jennie.psk                 -
wireguard/home/wg1.conf        homelab-restricted file  wireguard/home/wg1.conf              -
wireguard/home/wg3.conf        homelab-restricted file  wireguard/home/wg3.conf              -
wireguard/ruby/wg0.yaml        homelab-restricted file  wireguard/ruby/80-wireguard-wg0.yaml -
wireguard/ruby/wg1.yaml        homelab-restricted file  wireguard/ruby/81-wireguard-wg1.yaml -
wireguard/ruby/wg2.yaml        homelab-restricted file  wireguard/ruby/82-wireguard-wg2.yaml -
wireguard/jennie/wg2.yaml      homelab-restricted file  wireguard/jennie/82-wireguard-wg2.yaml -
wireguard/jennie/wg3.yaml      homelab-restricted file  wireguard/jennie/83-wireguard-wg3.yaml -

