# Copy to secrets.env and fill in. Gitignored (**/secrets.env), same shape as
# dns/secrets.env.
#
# HOMEASSISTANT_TOKEN: a long-lived access token from Home Assistant, created
# on the user's profile page (moby, 192.168.1.79). deploy.sh installs it at
# /etc/prometheus/homeassistant.token, owned by prometheus and mode 0400, and
# the homeassistant job reads it with authorization.credentials_file.
HOMEASSISTANT_TOKEN=
