// /etc/bind/named.conf.local - vps-5ca50660.vps.ovh.net
//
// View selection is by query source address, and the first matching view
// wins. A query from a source matching neither view gets REFUSED, which
// combined with the listen-on list in named.conf.options means the public
// addresses have no DNS service at all.
//
// No localhost, 0, 127 or 255 zones in either view. Debian's bind9 dropped
// db.local, db.0, db.127, db.255 and named.conf.default-zones in 9.20.5,
// relying on BIND's automatic empty zones (0.in-addr.arpa, 127.in-addr.arpa,
// 255.255.255.255.in-addr.arpa) instead; named-checkconf -z fails while a
// zone still names one of those files. localhost itself gets NXDOMAIN, as
// on jennie: hosts resolve it from /etc/hosts.

// ===========================================================================
// VPN sources: everything reachable over WireGuard. A site's own traffic to
// this host leaves from its tunnel address, hence the transit range.
// 172.31.1.0/24 does not overlap the internal view's 172.16.0.0/16.
// ===========================================================================
acl "vpn" {
    192.168.204.0/24;       // wg0 clients
    192.168.205.0/24;       // jennie's wg0 clients
    192.168.8.0/21;         // home LANs
    192.168.254.0/24;       // site service addresses (dummy interfaces)
    172.31.1.0/24;          // site-to-site transit links
    fd33:5692:1834::/48;    // VPN ULA: clients, home LANs, sites, transit
};

// ===========================================================================
// INTERNAL - the host itself and Docker containers
//
// No local copy of peetvandesande.com. The mail server and its containers
// resolve the domain recursively, exactly as the outside world does. A
// split-horizon answer here is how you end up with mail that works
// internally and fails externally, with nothing visible from the console.
// ===========================================================================
view "internal" {
    match-clients { 127.0.0.0/8; ::1; 172.16.0.0/16; };

    recursion yes;
    allow-recursion { 127.0.0.0/8; ::1; 172.16.0.0/16; };
    allow-query      { 127.0.0.0/8; ::1; 172.16.0.0/16; };
    allow-query-cache { 127.0.0.0/8; ::1; 172.16.0.0/16; };

    zone "." { type hint; file "/usr/share/dns/root.hints"; };

    zone "docker.local" {
        type master;
        file "/var/lib/bind/db.docker.local";
        allow-update { 127.0.0.0/8; ::1; };
    };

    // The VPN's reverse zones, so Postfix and Dovecot log VPN peers by name.
    // The same files as the wireguard view's: they are plain primaries with
    // no journal, so two views may share them. Reverse zones only - the
    // split-horizon forward zones stay out of this view, as above. They
    // answer beneath this view's automatic 168.192, 31.172 and d.f.ip6.arpa
    // empty zones.
    zone "204.168.192.in-addr.arpa" {
        type primary;
        file "/etc/bind/wireguard/204.168.192.in-addr.arpa";
        notify no;
    };

    zone "205.168.192.in-addr.arpa" {
        type primary;
        file "/etc/bind/wireguard/205.168.192.in-addr.arpa";
        notify no;
    };

    zone "254.168.192.in-addr.arpa" {
        type primary;
        file "/etc/bind/wireguard/254.168.192.in-addr.arpa";
        notify no;
    };

    zone "1.31.172.in-addr.arpa" {
        type primary;
        file "/etc/bind/wireguard/1.31.172.in-addr.arpa";
        notify no;
    };

    zone "4.3.8.1.2.9.6.5.3.3.d.f.ip6.arpa" {
        type primary;
        file "/etc/bind/wireguard/4.3.8.1.2.9.6.5.3.3.d.f.ip6.arpa";
        notify no;
    };
};

// ===========================================================================
// WIREGUARD - everything on the VPN (clients, home, jennie), with
// split-horizon overrides
//
// This zone deliberately contradicts the public copy: mail and imap resolve
// to 192.168.204.254 so peers reach submission over the tunnel rather than
// hairpinning out to the public address and being refused.
//
// It is unsigned, and the public zone at the registrar must stay unsigned
// too. If the parent ever publishes a DS record for peetvandesande.com, a
// peer running its own validating stub resolver (Android Private DNS,
// systemd-resolved with DNSSEC=yes, a local unbound) will treat these
// answers as BOGUS and fail to resolve them. That is the actual constraint,
// and it has nothing to do with whether this server validates other
// people's domains.
// ===========================================================================
view "wireguard" {
    match-clients { vpn; };

    recursion yes;
    allow-recursion { vpn; };
    allow-query      { vpn; };
    allow-query-cache { vpn; };

    zone "." { type hint; file "/usr/share/dns/root.hints"; };

    zone "mail.peetvandesande.com" {
        type primary;
        file "/etc/bind/wireguard/mail.peetvandesande.com";
        notify no;
    };

    zone "ruby.peetvandesande.com" {
        type primary;
        file "/etc/bind/wireguard/ruby.peetvandesande.com";
        notify no;
    };

    zone "sogode.com" {
        type primary;
        file "/etc/bind/wireguard/sogode.com";
        notify no;
    };

    zone "www.sogode.com" {
        type primary;
        file "/etc/bind/wireguard/www.sogode.com";
        notify no;
    };

    zone "204.168.192.in-addr.arpa" {
        type primary;
        file "/etc/bind/wireguard/204.168.192.in-addr.arpa";
    };

    // jennie's clients, the service addresses, the transit links and the
    // VPN ULA /48. The zone files live in the repo under
    // jennie/services/etc/bind/wireguard/ and are identical on both hosts.
    // 205 and 254 are needed because disable-empty-zone below sends every
    // other 168.192 PTR to the AS112 servers. The automatic empty zones
    // 31.172.in-addr.arpa and d.f.ip6.arpa stay: the transit and ULA zones
    // answer beneath them.
    zone "205.168.192.in-addr.arpa" {
        type primary;
        file "/etc/bind/wireguard/205.168.192.in-addr.arpa";
        notify no;
    };

    zone "254.168.192.in-addr.arpa" {
        type primary;
        file "/etc/bind/wireguard/254.168.192.in-addr.arpa";
        notify no;
    };

    zone "1.31.172.in-addr.arpa" {
        type primary;
        file "/etc/bind/wireguard/1.31.172.in-addr.arpa";
        notify no;
    };

    zone "4.3.8.1.2.9.6.5.3.3.d.f.ip6.arpa" {
        type primary;
        file "/etc/bind/wireguard/4.3.8.1.2.9.6.5.3.3.d.f.ip6.arpa";
        notify no;
    };

    // The lab's internal domain, from Pythia over wg1. static-stub rather
    // than forward: Pythia is authoritative-only, so it is queried as the
    // zone's server (RD=0) and BIND does any further resolution itself.
    // Not Themis or Delphi - their ACLs admit only the home LAN and the
    // Proxmox lab networks, not VPN sources.
    zone "home" {
        type static-stub;
        server-addresses { 192.168.8.52; };
    };

    // Without this, BIND's automatic RFC 1918 empty zone answers for
    // 168.192.in-addr.arpa and the lab's PTRs never reach Pythia.
    disable-empty-zone "168.192.in-addr.arpa";

    // Zones for the home network
    zone "8.168.192.in-addr.arpa" {
        type static-stub;
        server-addresses { 192.168.8.52; };
    };
    zone "9.168.192.in-addr.arpa" {
        type static-stub;
        server-addresses { 192.168.8.52; };
    };
    zone "10.168.192.in-addr.arpa" {
        type static-stub;
        server-addresses { 192.168.8.52; };
    };
    zone "11.168.192.in-addr.arpa" {
        type static-stub;
        server-addresses { 192.168.8.52; };
    };
    zone "12.168.192.in-addr.arpa" {
        type static-stub;
        server-addresses { 192.168.8.52; };
    };
    zone "13.168.192.in-addr.arpa" {
        type static-stub;
        server-addresses { 192.168.8.52; };
    };
    zone "14.168.192.in-addr.arpa" {
        type static-stub;
        server-addresses { 192.168.8.52; };
    };
    zone "15.168.192.in-addr.arpa" {
        type static-stub;
        server-addresses { 192.168.8.52; };
    };

    // Zones for the home lab network
    zone "32.168.192.in-addr.arpa" {
        type static-stub;
        server-addresses { 192.168.8.52; };
    };
    zone "33.168.192.in-addr.arpa" {
        type static-stub;
        server-addresses { 192.168.8.52; };
    };
    zone "34.168.192.in-addr.arpa" {
        type static-stub;
        server-addresses { 192.168.8.52; };
    };
    zone "35.168.192.in-addr.arpa" {
        type static-stub;
        server-addresses { 192.168.8.52; };
    };
    zone "36.168.192.in-addr.arpa" {
        type static-stub;
        server-addresses { 192.168.8.52; };
    };
    zone "37.168.192.in-addr.arpa" {
        type static-stub;
        server-addresses { 192.168.8.52; };
    };
    zone "38.168.192.in-addr.arpa" {
        type static-stub;
        server-addresses { 192.168.8.52; };
    };
    zone "39.168.192.in-addr.arpa" {
        type static-stub;
        server-addresses { 192.168.8.52; };
    };
};
