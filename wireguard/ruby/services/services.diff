--- /dev/null
+++ /etc/systemd/system/postfix@-.service.d/local-deps.conf
@@ -0,0 +1,18 @@
+# /etc/systemd/system/postfix@-.service.d/local-deps.conf
+#
+# Postfix binds submission/smtps to wg0's addresses (192.168.204.254 and
+# fd33:5692:1834:204::254). If either is not yet configured when master
+# starts, the bind fails and Postfix exits. The stock unit only orders after
+# network.target, which does not wait for any interface.
+#
+# wg0 is managed by systemd-networkd (netplan): wait for networkd to report it
+# routable, i.e. addresses configured.
+#
+# Install with:
+#   mkdir -p /etc/systemd/system/postfix@-.service.d
+#   cp local-deps.conf /etc/systemd/system/postfix@-.service.d/
+#   systemctl daemon-reload
+
+[Unit]
+After=systemd-networkd-wait-online@wg0:routable.service
+Wants=systemd-networkd-wait-online@wg0:routable.service
