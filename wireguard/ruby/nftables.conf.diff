 # ===========================================================================
@@ -98,7 +98,7 @@
 
         # --- WireGuard site-to-site: IPv6 primary address -------------------
         # The S2S tunnels terminate on IPv6, and $PUB6 is the only IPv6
-        # address. wg1's peer (home-inet) dials in from a dynamic ISP address;
+        # address. wg1's peer (home) dials in from a dynamic ISP address;
         # wg2's peer is always jennie, so that one is pinned to its source.
         iifname "ens3" ip6 daddr $PUB6 udp dport 51821 accept
