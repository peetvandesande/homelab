; /etc/bind/wireguard/205.168.192.in-addr.arpa - jennie
;
; Reverse zone for jennie's client range 192.168.205.0/24 (wg0), the
; counterpart of ruby's 204.168.192.in-addr.arpa. Private space, so no
; delegation exists or is needed. Without it, reverse lookups of client
; addresses escape to the AS112 servers and time out.
;
; Validate after every edit:
;   named-checkzone 205.168.192.in-addr.arpa \
;                   /etc/bind/wireguard/205.168.192.in-addr.arpa
;   rndc reload 205.168.192.in-addr.arpa
;
; Bump the serial on every change. yyyymmddnn.

$ORIGIN 205.168.192.in-addr.arpa.
$TTL 3600

@   IN  SOA jennie. hostmaster.peetvandesande.com. (
            2026101501  ; serial
            3600        ; refresh   (no secondary; value is inert)
            900         ; retry     (inert)
            604800      ; expire    (inert)
            300 )       ; negative cache TTL

    IN  NS  jennie.

254	IN	PTR	jennie.

1	IN	PTR	mba.
2	IN	PTR	iphone-peet.
4	IN	PTR	mbp.
