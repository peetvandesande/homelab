// /etc/bind/named.conf.local - jennie
//
// The zones of ruby's "wireguard" view, so jennie's clients get the same
// answers as ruby's. The split-horizon and reverse zone files in
// /etc/bind/wireguard/ are the same on both hosts: the repo's copies in
// jennie/services/etc/bind/wireguard/ are installed on ruby too. Change
// them on both hosts together. Their answers still point at ruby
// (192.168.204.254), so mail and the sites follow ruby's availability,
// but resolution itself does not.
//
// Unlike ruby these zones are not in a view; see named.conf.options.

// ===========================================================================
// Split-horizon overrides, copied from ruby. See ruby's named.conf.local
// for why these contradict the public zones and why those must stay
// unsigned.
// ===========================================================================
zone "mail.peetvandesande.com" {
    type primary;
    file "/etc/bind/wireguard/mail.peetvandesande.com";
    notify no;
};

zone "ruby.peetvandesande.com" {
    type primary;
    file "/etc/bind/wireguard/ruby.peetvandesande.com";
    notify no;
};

zone "sogode.com" {
    type primary;
    file "/etc/bind/wireguard/sogode.com";
    notify no;
};

zone "www.sogode.com" {
    type primary;
    file "/etc/bind/wireguard/www.sogode.com";
    notify no;
};

zone "git.peetvandesande.com" {
    // The lab's public services, answered with the lab's own addresses
    // as on the LAN - ../../CLAUDE.md, "Public services".
    type primary;
    file "/etc/bind/wireguard/git.peetvandesande.com";
    notify no;
};

zone "n8n.peetvandesande.com" {
    // The lab's public services, answered with the lab's own addresses
    // as on the LAN - ../../CLAUDE.md, "Public services".
    type primary;
    file "/etc/bind/wireguard/n8n.peetvandesande.com";
    notify no;
};

// ===========================================================================
// Reverse zones: the client ranges, the service addresses, the transit
// links and the VPN ULA /48 (identical on both hosts).
// ===========================================================================
zone "204.168.192.in-addr.arpa" {
    type primary;
    file "/etc/bind/wireguard/204.168.192.in-addr.arpa";
    notify no;
};

zone "205.168.192.in-addr.arpa" {
    type primary;
    file "/etc/bind/wireguard/205.168.192.in-addr.arpa";
    notify no;
};

zone "254.168.192.in-addr.arpa" {
    type primary;
    file "/etc/bind/wireguard/254.168.192.in-addr.arpa";
    notify no;
};

zone "1.31.172.in-addr.arpa" {
    type primary;
    file "/etc/bind/wireguard/1.31.172.in-addr.arpa";
    notify no;
};

zone "4.3.8.1.2.9.6.5.3.3.d.f.ip6.arpa" {
    type primary;
    file "/etc/bind/wireguard/4.3.8.1.2.9.6.5.3.3.d.f.ip6.arpa";
    notify no;
};

// ===========================================================================
// The lab's internal domain, from Pythia over wg3 - direct, not via ruby.
// static-stub rather than forward: Pythia is authoritative-only, so it is
// queried as the zone's server (RD=0). Not Themis or Delphi - their ACLs
// admit only the home LAN and the Proxmox lab networks, not VPN sources.
// Both need options in named.conf.options: validate-except, because they
// are unsigned, and disable-empty-zone for the reverse zone.
// ===========================================================================
zone "home" {
    type static-stub;
    server-addresses { 192.168.8.52; };
};

zone "8.168.192.in-addr.arpa" {
    type static-stub;
    server-addresses { 192.168.8.52; };
};

// The Proxmox labs, one zone per /24 of 192.168.32.0/21, so a client that
// failed over to jennie still gets the lab's PTRs. A lab creates and deletes
// its own zones through Pythia's API, so while none is running these
// SERVFAIL - expected, and what Delphi gives the LAN (dns/README.md, "Lab
// zones"). Only this one /24 of the home range is stubbed, and the guest,
// iot and ONT nets are not: Pythia holds no reverse zone for them, and a
// stub would turn their NXDOMAIN into a SERVFAIL.
zone "32.168.192.in-addr.arpa" {
    type static-stub;
    server-addresses { 192.168.8.52; };
};
zone "33.168.192.in-addr.arpa" {
    type static-stub;
    server-addresses { 192.168.8.52; };
};
zone "34.168.192.in-addr.arpa" {
    type static-stub;
    server-addresses { 192.168.8.52; };
};
zone "35.168.192.in-addr.arpa" {
    type static-stub;
    server-addresses { 192.168.8.52; };
};
zone "36.168.192.in-addr.arpa" {
    type static-stub;
    server-addresses { 192.168.8.52; };
};
zone "37.168.192.in-addr.arpa" {
    type static-stub;
    server-addresses { 192.168.8.52; };
};
zone "38.168.192.in-addr.arpa" {
    type static-stub;
    server-addresses { 192.168.8.52; };
};
zone "39.168.192.in-addr.arpa" {
    type static-stub;
    server-addresses { 192.168.8.52; };
};
