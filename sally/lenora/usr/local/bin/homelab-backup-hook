#!/bin/bash
# vzdump hook for the nightly backup to sally. Runs on lenora and publishes each
# guest's last good backup through node-exporter's textfile collector.
#
# The figures come from lenora because sally is powered off most of the day:
# only something that stays up can say a backup did not happen.
set -u

phase=$1
vmid=${3:-}
[[ ${STOREID:-} == sally ]] || exit 0

STATE=/var/lib/homelab-backup
TEXTFILE=/var/lib/node_exporter/textfile/backup.prom

publish() {
  local tmp id name stamp expiry
  tmp=$(mktemp "$TEXTFILE.XXXXXX")
  # Lab VMs are 9000 and up and are disposable. Every other guest is listed even
  # with no backup yet, so one added and never scheduled reports a stamp of zero.
  { pct list | awk 'NR>1 {print $1, $NF}'; qm list | awk 'NR>1 {print $1, $2}'; } | sort -n |
    while read -r id name; do
      ((id < 9000)) || continue
      stamp=$(cat "$STATE/$id" 2>/dev/null || echo 0)
      echo "homelab_backup_last_success_timestamp_seconds{vmid=\"$id\",guest=\"$name\"} $stamp"
    done > "$tmp"
  expiry=$(echo | timeout 10 openssl s_client -connect sally.home:8007 -servername sally.home 2>/dev/null |
    openssl x509 -noout -enddate 2>/dev/null | cut -d= -f2)
  [[ -n $expiry ]] && echo "homelab_sally_certificate_expiry_timestamp_seconds $(date -d "$expiry" +%s)" >> "$tmp"
  chmod 0644 "$tmp"
  mv -f "$tmp" "$TEXTFILE"
}

case $phase in
  job-start)
    mkdir -p "$STATE"
    publish
    ;;
  backup-end)
    date +%s > "$STATE/$vmid"
    ;;
  job-end)
    publish
    # The first Sunday of the month, straight after the backups: sally stays on
    # while a restore is reading from it.
    if [[ $(date +%u) == 7 && $(date +%-d) -le 7 ]]; then
      systemd-run --no-block --collect --unit=homelab-backup-restore-test /usr/local/bin/homelab-backup-restore-test
    fi
    ;;
esac
exit 0
